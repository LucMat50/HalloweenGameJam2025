; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HalloweenGameJam2025"
run/main_scene="uid://yxmwt4kvkrb3"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
PuzzleManager="*res://Scripts/PuzzleManager.gd"
AudioGlobal="*res://Scripts/AudioGlobal.gd"

[dialogic]

directories/dch_directory={
"Cow": "res://Dialogic/Characters/Cow.dch",
"DebugCharacter": "res://Dialogic/Characters/DebugCharacter.dch",
"Pig": "res://Dialogic/Characters/Pig.dch",
"PigAndCow": "res://Dialogic/Characters/PigAndCow.dch",
"Player": "res://Dialogic/Characters/Player.dch"
}
directories/dtl_directory={
"Animals": "res://Dialogic/Timelines/Animals.dtl",
"Animals2": "res://Dialogic/Timelines/Animals2.dtl",
"Blueprints": "res://Dialogic/Timelines/Items/Blueprints.dtl",
"Bucket": "res://Dialogic/Timelines/Items/Bucket.dtl",
"Butchers Notes": "res://Dialogic/Timelines/Items/Butchers Notes.dtl",
"Compass": "res://Dialogic/Timelines/Items/Compass.dtl",
"Engine": "res://Dialogic/Timelines/Items/Engine.dtl",
"GoodEnding": "res://Dialogic/Timelines/Endings/GoodEnding.dtl",
"Hose": "res://Dialogic/Timelines/Items/Hose.dtl",
"Manual": "res://Dialogic/Timelines/Items/Manual.dtl",
"Mounted Deer Head": "res://Dialogic/Timelines/Items/Mounted Deer Head.dtl",
"Plushie": "res://Dialogic/Timelines/Items/Plushie.dtl",
"PrereqNotMetBasic": "res://Dialogic/Timelines/PrereqNotMetBasic.dtl",
"Rug": "res://Dialogic/Timelines/Items/Rug.dtl",
"Safe": "res://Dialogic/Timelines/Items/Safe.dtl",
"Saw": "res://Dialogic/Timelines/Items/Saw.dtl",
"Shed Key": "res://Dialogic/Timelines/Items/Shed Key.dtl",
"Shed door": "res://Dialogic/Timelines/Items/Shed door.dtl",
"Truck": "res://Dialogic/Timelines/Items/Truck.dtl",
"Window": "res://Dialogic/Timelines/Items/Window.dtl",
"key": "res://Dialogic/Timelines/Items/key.dtl",
"test_timeline_1": "res://Dialogic/Timelines/test_timeline_1.dtl"
}
layout/style_directory={
"": "res://Resources/DialogStyle.tres",
"DialogStyle": "res://Resources/DialogStyle.tres"
}
layout/style_list=["res://Resources/DialogStyle.tres"]
layout/default_style="res://Resources/DialogStyle.tres"
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.0
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/split_at_new_lines=false
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
text/autoadvance_fixed_delay=1.0
text/autocolor_names=false
text/absolute_autopauses=false
layout/end_behaviour=0
glossary/default_case_sensitive=true
variables={}

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Dialogic/": "yellow",
"res://Inventory/": "green",
"res://Resources/": "teal",
"res://Scenes/": "blue",
"res://Scripts/": "purple",
"res://addons/": "red"
}

